<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DISABLED STATE -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/item_background" />
            <corners android:radius="@dimen/margin_4" />
            <stroke android:width="1px" android:color="@color/button_disabled_border" />
        </shape>
    </item>

    <!-- NORMAL STATE -->
    <item>
        <ripple android:color="@android:color/white">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="@dimen/margin_4" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid
                        android:color="@color/button_translucent_positive"/>
                    <corners android:radius="@dimen/margin_4" />
                    <stroke android:width="1px" android:color="@color/button_translucent_positive_border" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
