<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item>
    <ripple android:color="@color/item_ripple">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@color/item_ripple" />
                <corners android:topLeftRadius="@dimen/margin_6"  android:topRightRadius="@dimen/margin_6"/>
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/item_background" />
                <corners android:topLeftRadius="@dimen/margin_6"  android:topRightRadius="@dimen/margin_6"/>
            </shape>
        </item>
    </ripple>
</item>
</selector>
