<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <ripple android:color="@android:color/white">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="@dimen/margin_4" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="90"
                        android:endColor="@color/fab_gradient_start"
                        android:startColor="@color/fab_gradient_end" />
                    <stroke
                        android:width="1px"
                        android:color="@color/fab_gradient_end_border" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
